{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh build-static.sh",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/ui-prototype", "destination": "/", "permanent": false },
    { "source": "/ui-prototype/:path*", "destination": "/", "permanent": false }
  ]
}
